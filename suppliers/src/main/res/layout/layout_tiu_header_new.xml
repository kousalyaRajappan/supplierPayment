<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tiu_title_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="top"
    android:background="#000"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp">
        <TextView
            android:id="@+id/tiu_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:layout_marginLeft="@dimen/pad_5dp"
            android:textSize="@dimen/headtextSize"
            android:textColor="#fff" />
        <View
            android:id="@+id/view1"
            android:layout_toRightOf="@+id/tiu_clock"
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:background="#FFFF00"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="4dp"/>
        <TextView
            android:layout_toRightOf="@+id/view1"
            android:id="@+id/tiu_title_outlet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginLeft="@dimen/pad_5dp"
            android:text=""
            android:textStyle="bold"
            android:textSize="@dimen/headtextSize"
            android:textColor="#fff" />
        <TextView
            android:layout_alignParentRight="true"
            android:id="@+id/tiu_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:maxLength="24"
            android:text=""
            android:layout_marginRight="@dimen/pad_5dp"
            android:textSize="@dimen/headtextSize"
            android:textColor="#fff" />

    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp">
        <TextView

            android:id="@+id/tiu_title_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/pad_5dp"

            android:textSize="@dimen/headtextSize"
            android:text=""
            android:textColor="#fff" />
        <View
            android:visibility="gone"
            android:id="@+id/view2"
            android:layout_toRightOf="@+id/tiu_title_balance"
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:background="#FFFF00"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="4dp"/>
        <TextView
            android:layout_marginLeft="@dimen/pad_5dp"

            android:layout_toRightOf="@+id/view2"
            android:id="@+id/tiu_title_balance_cash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=""

            android:textSize="@dimen/headtextSize"
            android:textColor="#fff" />
        <RelativeLayout
            android:layout_alignParentRight="true"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txt_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Version"
                android:layout_marginRight="2dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
