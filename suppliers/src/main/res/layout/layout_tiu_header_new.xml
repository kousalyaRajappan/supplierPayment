    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="20dp">
        <TextView

            android:id="@+id/tiu_title_balance_commision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/pad_5dp"

            android:textSize="@dimen/headtextSize"
            android:text=""
            android:textColor="#fff" />
        <View
            android:visibility="gone"
            android:id="@+id/view3"
            android:layout_toRightOf="@+id/tiu_title_balance_commision"
            android:layout_width="2dp"
            android:layout_height="10dp"
            android:background="#FFFF00"
            android:layout_marginTop="2dp"
            android:layout_marginLeft="4dp"/>
        <TextView
            android:layout_marginLeft="@dimen/pad_5dp"

            android:layout_toRightOf="@+id/view3"
            android:id="@+id/tiu_title_balance_swipe"
            android:layout_width="wrap_content"
