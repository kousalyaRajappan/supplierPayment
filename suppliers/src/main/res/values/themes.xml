<resources>
    <!-- Base application theme. -->
    <style name="Theme.SupplierManagement" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/tiu_red</item>
        <!-- <item name="colorPrimaryVariant">@color/purple_700</item> -->
        <item name="colorPrimaryVariant">@color/tiu_red2</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <!--<item name="colorSecondary">@color/teal_200</item>-->
        <item name="colorSecondary">@color/tiu_grey</item>
        <item name="colorSecondaryVariant">@color/tiu_grey2</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/black</item>
        <!-- Customize your theme here. -->

        <item name="android:textColor">?attr/colorOnSecondary</item>

    </style>

    <style name="addSupplierButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/tiu_green</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="addSupplierImageButton">
        <item name="android:backgroundTint">@color/tiu_green</item>
        <item name="android:tint">@color/white</item>
        <item name="android:scaleX">1.5</item>
        <item name="android:scaleY">1.5</item>
    </style>
    <style name="makePaymentButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/tiu_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:shadowColor">#420505</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">5</item>
    </style>

    <style name="tabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIconTint">@color/tab_item_text_colour</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorColor">@color/tab_item_text_colour</item>
        <item name="tabTextColor">@color/tab_item_text_colour</item>
    </style>

    <style name="customTabItem">
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/tab_item_text_colour</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>


</resources>